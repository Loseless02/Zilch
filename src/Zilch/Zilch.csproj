<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <AssemblyName>Zilch</AssemblyName>
    <RootNamespace>Zilch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>zilch.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>Zilch</Product>
    <Description>Find what eats your disk and remove it with zilch left behind.</Description>
    <Copyright>Loseless02</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="zilch.ico" LogicalName="zilch.ico" />
  </ItemGroup>

</Project>
